# Defaults to a local SQLite file when unset.
MOGUL_DATABASE_URL=postgresql+psycopg://mogul:mogul@localhost:5432/mogul
MOGUL_CORS_ORIGINS=["http://localhost:3000"]
# For-sale listings from RentCast (https://app.rentcast.io/app/api); optional.
MOGUL_RENTCAST_API_KEY=
MOGUL_LISTING_AREAS=["Memphis, TN", "Indianapolis, IN"]
# HUD Fair Market Rents (free token: https://www.huduser.gov/hudapi/public/register); optional.
MOGUL_HUD_API_TOKEN=
# Census API key (https://api.census.gov/data/key_signup.html); optional, raises rate limits.
MOGUL_CENSUS_API_KEY=
